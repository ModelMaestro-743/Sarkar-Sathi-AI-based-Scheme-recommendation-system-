"{\n  \"user_profile_summary\": \"श्रेया ही महाराष्ट्रातील ग्रामीण भागातील 22 वर्षांची एकल महिला आहे, जी एक स्वतंत्र व्यवसायिक आहे आणि आरोग्यासाठी तिचा रस आहे, तिची मासिक उत्पन्न ₹20,000 आहे.\",\n  \"recommended_schemes\": [\n    {\n      \"rank\": 1,\n      \"scheme_name\": \"ममता तरुणी अभियान\",\n      \"relevance_reason\": \"ही योजना महिलांचे आणि किशोरींचे आरोग्य आणि कल्याणावर लक्ष केंद्रित करते, जे श्रेयानुसार आरोग्यावरच्या तिच्या रसाशी संलग्न आहे.\",\n      \"benefits\": \"आरोग्य तपासणी, गर्भावस्थेतील देखभाल, प्रसूतीनंतरची देखभाल, पोषण आधार, आरोग्य शिक्षण, आणि गर्भवती महिलांसाठी आर्थिक सहाय्य मिळविण्याचा सहयोग.\",\n      \"eligibility_summary\": \"या योजनेत 10-19 वर्षे वयाच्या किशोरींना आणि गुजरातच्या निवासी गर्भवती महिलांना समाविष्ट केले आहे, आणि BPL कुटुंबांना प्राधान्य दिले जाते.\",\n      \"application_process\": \"जवळच्या आरोग्य केंद्रावर जा, अर्जाची फॉर्म भरा, आवश्यक कागदपत्रे सादर करा, आणि नोंदणी करा.\",\n      \"required_documents\": \"ओळखपत्र, वैद्यकीय प्रमाणपत्र (गर्भवती महिलांसाठी), बँक खाते माहिती, उत्पन्न प्रमाणपत्र (BPL कुटुंबांसाठी), पत्याचे प्रमाणपत्र.\",\n      \"level\": \"राज्य\",\n      \"category\": \"आरोग्य आणि कल्याण, महिला आणि बाल\"\n    },\n    {\n      \"rank\": 2,\n      \"scheme_name\": \"मुख्यमंत्री अमृतम योजना\",\n      \"relevance_reason\": \"ही योजना BPL कुटुंबांसाठी आरोग्य विमा कव्हरेज प्रदान करते, जे श्रेयाच्या आरोग्याच्या गरजांसाठी उपयुक्त ठरू शकते.\",\n      \"benefits\": \"अर्थातच अंदाजे ₹5,00,000/- पर्यंत आरोग्य विमा कव्हरेज, ज्या रोगांसाठी रुग्णालयात उपचार आवश्यक असतात.\",\n      \"eligibility_summary\": \"राज्य सरकारच्या BPL यादीत असणारे व्यक्ती आणि कुटुंबे पात्र आहेत.\",\n      \"application_process\": \"सिव्हिल हॉस्पिटल किंवा सामुदायिक सेवा केंद्रांमध्ये नोंदणी करा, आवश्यक कागदपत्रे सादर करा.\",\n      \"required_documents\": \"उत्पन्नाचा पुरावा, सरकारी प्रमाणपत्र, निवासाचा पुरावा.\",\n      \"level\": \"राज्य\",\n      \"category\": \"आरोग्य आणि कल्याण\"\n    },\n    {\n      \"rank\": 3,\n      \"scheme_name\": \"महात्मा गांधी राष्ट्रीय ग्रामीण रोजगार हमी कायदा\",\n      \"relevance_reason\": \"ही योजना हमीदार नोकर्या प्रदान करते, ज्यामुळे श्रेयाची आर्थिक स्थिती सुधारू शकते.\",\n      \"benefits\": \"15 दिवसांच्या आत हमीदार नोकर्या, एक आठवड्यात वेतन मिळवले जाते, आणि अपंग व्यक्ती आणि ज्येष्ठांसाठी तरतुदी असतात.\",\n      \"eligibility_summary\": \"अर्जदारांचा किमान वय 18 वर्षे असावे आणि ग्रामीण भागात रहिवासी असावे.\",\n      \"application_process\": \"स्थानिक ग्रामपंचायतीकडे साध्या कागदावर नोंदणीसाठी अर्ज सादर केला जाऊ शकतो.\",\n      \"required_documents\": \"फोटो, ओळख पत्र, कुटुंबातील सदस्यांची माहिती.\",\n      \"level\": \"केंद्र\",\n      \"category\": \"कौशल्य आणि रोजगार, सामाजिक कल्याण आणि सशक्तीकरण\"\n    }\n  ]\n}"